# Default: normal auto handling (specific rules below override this —
# in .gitattributes the LAST matching line wins, so the catch-all goes first)
* text=auto

# Batch files MUST keep Windows (CRLF) line endings — cmd.exe goto/labels
# break with Unix (LF) endings. -text stores bytes exactly as committed so
# GitHub ZIP downloads and clones both receive working files.
*.bat -text
*.ps1 -text
